// Static list (generated by a one-line loop): B_S_<L> for L = 0..447.
// SPEC::hash m == S::composed(pad m), pad written as in Specification.cry: M # 0b1 # zero # (`L : [64])
prove_print (w4_unint_yices []) {{ \(m : [0]) -> SPEC::hash m == join (S::composed (split (((m # 0b1) # (zero : [447])) # (0 : [64])))) }};
print "PROVED B_S_0";
prove_print (w4_unint_yices []) {{ \(m : [1]) -> SPEC::hash m == join (S::composed (split (((m # 0b1) # (zero : [446])) # (1 : [64])))) }};
